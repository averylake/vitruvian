  margin-bottom: 4vh;
}

.assembly-intro__title {
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 3vw, 2.2rem);
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 0.06em;
  margin-bottom: 1rem;
}

.assembly-intro__text {
  font-family: var(--font-sans);
  font-size: var(--text-sm);
