}

.triptych-title {
  text-align: center;
  font-family: var(--font-sans);
  font-size: clamp(1rem, 2vw, 1.6rem);
  font-weight: 300;
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.65);
