  height: 100%;
  pointer-events: none;
  z-index: 2;
}

.triptych-label {
  margin-top: 1.2rem;
  font-family: var(--font-sans);
  font-size: clamp(0.75rem, 1.2vw, 0.95rem);
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
