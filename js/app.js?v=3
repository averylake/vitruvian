/* ============================================================
   THE VITRUVIAN LENS — Scroll Engine & Interactions
   Enhanced with Shopify-inspired techniques
   ============================================================ */

(function () {
    'use strict';

    // --- Reduced Motion Detection ---
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- Lenis Smooth Scroll ---
    let lenis = null;
    if (typeof Lenis !== 'undefined' && !prefersReducedMotion) {
        lenis = new Lenis({
            duration: 1.2,
            easing: function (t) {
                return Math.min(1, 1.001 - Math.pow(2, -10 * t));
            },
            orientation: 'vertical',
            smoothWheel: true,
            wheelMultiplier: 1
        });

        // Lenis ↔ GSAP ScrollTrigger sync
        lenis.on('scroll', function () {
            if (typeof ScrollTrigger !== 'undefined') {
                ScrollTrigger.update();
            }
        });

        // rAF loop for Lenis
        function raf(time) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // Override scrollTo for era nav dots to use Lenis
        window.__lenisScrollTo = function (target) {
            lenis.scrollTo(target, { offset: 0, duration: 1.2 });
        };
    }

    // --- Grain Noise Canvas (Enhanced) ---
    (function initGrain() {
        const canvas = document.getElementById('grainCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        let w, h;

        function resize() {
            w = canvas.width = canvas.offsetWidth;
            h = canvas.height = canvas.offsetHeight;
        }
        resize();
        window.addEventListener('resize', resize);

        function drawGrain() {
            const imageData = ctx.createImageData(w, h);
            const data = imageData.data;
            for (let i = 0; i < data.length; i += 4) {
                const v = Math.random() * 255;
                data[i] = v;
                data[i + 1] = v;
                data[i + 2] = v;
                data[i + 3] = 255;
            }
            ctx.putImageData(imageData, 0, 0);
        }

        // Draw once, then redraw slowly for subtle movement
        drawGrain();
        setInterval(drawGrain, 120);
    })();

    // --- Enhanced Grain: SVG filter overlay (second layer) ---
    (function initSVGGrain() {
        // Add a fixed SVG noise overlay for richer texture
        const grainOverlay = document.createElement('div');
        grainOverlay.className = 'grain-overlay-svg';
        grainOverlay.setAttribute('aria-hidden', 'true');
        document.body.appendChild(grainOverlay);
    })();

    // --- Split Title (removed — new prologue uses CSS fade-up) ---

    gsap.registerPlugin(ScrollTrigger);

    // If Lenis is active, tell GSAP to use it as the scroller proxy
    if (lenis) {
        gsap.ticker.add(function (time) {
            lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);
    }

    // --- DOM References ---
    const progressBar = document.getElementById('progressBar');
    const eraNav = document.getElementById('eraNav');
    const navDots = document.querySelectorAll('.era-nav__item');
    const eras = document.querySelectorAll('.era');
    const revealElements = document.querySelectorAll('[data-reveal]');

    // --- Progress Bar ---
    gsap.to(progressBar, {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: {
            trigger: document.body,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.3
        }
    });

    // --- Show Era Nav after scrolling past prologue ---
    ScrollTrigger.create({
        trigger: '#era-the-word',
        start: 'top 80%',
        onEnter: () => eraNav.classList.add('visible'),
        onLeaveBack: () => eraNav.classList.remove('visible')
    });

    // --- Era Navigation Items ---
    navDots.forEach(dot => {
        const eraId = dot.dataset.era;
        const section = document.getElementById('era-' + eraId);
        if (!section) return;

        // Click to scroll (use Lenis if available)
        dot.addEventListener('click', () => {
            if (window.__lenisScrollTo) {
                window.__lenisScrollTo(section);
            } else {
                section.scrollIntoView({ behavior: 'smooth' });
            }
        });

        // Active state
        ScrollTrigger.create({
            trigger: section,
            start: 'top 60%',
            end: 'bottom 40%',
            onToggle: self => {
                if (self.isActive) {
                    navDots.forEach(d => d.classList.remove('active'));
                    dot.classList.add('active');
                }
            }
        });
    });

    // --- Scroll-triggered reveals ---
    revealElements.forEach((el, i) => {
        ScrollTrigger.create({
            trigger: el,
            start: 'top 85%',
            once: true,
            onEnter: () => {
                el.classList.add('visible');
            }
        });
    });

    // --- Vitruvian Ghost: scroll-driven line-draw ---
    // Deferred to window 'load' so GSAP calculates positions after the full
    // page layout has settled (Three.js canvases, images, prelude, etc.)
    window.addEventListener('load', function () {
        setTimeout(function () {
            ScrollTrigger.refresh(true);

            const ghostCircle = document.querySelector('.vitruvian-ghost__circle');
            const ghostSquare = document.querySelector('.vitruvian-ghost__square');
            if (ghostCircle && ghostSquare && !prefersReducedMotion) {
                const ghostTL = gsap.timeline({
                    scrollTrigger: {
                        trigger: '#vitruvianGhost',
                        start: 'top 85%',
                        end: 'top 30%',
                        scrub: 0.6
                    }
                });
                // Circle draws first (0% → 60% of scroll range)
                ghostTL.to(ghostCircle, {
                    strokeDashoffset: 0,
                    duration: 0.6,
                    ease: 'power2.inOut'
                });
                // Square draws second (60% → 100% of scroll range)
                ghostTL.to(ghostSquare, {
                    strokeDashoffset: 0,
                    duration: 0.4,
                    ease: 'power2.inOut'
                });
            }
        }, 500);
    });

    // --- Heading Text Reveals (word-by-word) ---
    (function initHeadingReveals() {
        if (prefersReducedMotion) return;

        const headings = document.querySelectorAll('.era__title');
        headings.forEach(heading => {
            // Split text into words wrapped in spans
            const text = heading.textContent.trim();
            const words = text.split(/\s+/);
            heading.textContent = '';
            heading.classList.add('title-reveal');

            words.forEach((word, i) => {
                const span = document.createElement('span');
                span.className = 'title-reveal__word';
                span.textContent = word;
                span.style.transitionDelay = (i * 0.08) + 's';
                heading.appendChild(span);
                // Add space between words
                if (i < words.length - 1) {
                    heading.appendChild(document.createTextNode(' '));
                }
            });

            // Trigger reveal on scroll using GSAP
            ScrollTrigger.create({
                trigger: heading,
                start: 'top 80%',
                once: true,
                onEnter: () => {
                    heading.classList.add('title-revealed');
                }
            });
        });
    })();

    // --- Era 2: Struggle overlays appear on scroll ---
    const overlay1 = document.getElementById('overlay1');
    const overlay2 = document.getElementById('overlay2');
    const struggleVerdict = document.querySelector('.struggle-verdict');

    if (overlay1 && overlay2) {
