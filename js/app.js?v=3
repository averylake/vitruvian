            const isActive = toggleMirror.classList.toggle('active');
            mirrorText.style.display = isActive ? 'block' : 'none';
            if (isActive) {
                mirrorText.classList.add('visible');
                requestAnimationFrame(() => {
                    mirrorText.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
