    // --- Enhancement 6: Parallax Depth Layers ---
    (function initParallax() {
        if (prefersReducedMotion) return;

        const parallaxElements = document.querySelectorAll('[data-parallax]');
        parallaxElements.forEach(el => {
            const speed = parseFloat(el.dataset.parallax) || 0.15;
            const yDistance = 80 * speed; // Max travel in pixels

            gsap.fromTo(el,
                { y: yDistance },
                {
                    y: -yDistance,
                    ease: 'none',
                    scrollTrigger: {
                        trigger: el,
                        start: 'top bottom',
                        end: 'bottom top',
                        scrub: 0.5
                    }
                }
            );
        });
    })();
    // --- Bibliography Toggle ---
    (function initBibliographyToggle() {
        const toggleBtn = document.getElementById('toggleBibliography');
        const panel = document.getElementById('bibliographyPanel');
        if (!toggleBtn || !panel) return;

        toggleBtn.addEventListener('click', () => {
            const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
            toggleBtn.setAttribute('aria-expanded', !isOpen);

            if (isOpen) {
                panel.classList.remove('open');
                setTimeout(() => { panel.hidden = true; }, 600);
            } else {
                panel.hidden = false;
                // Force reflow before adding class for transition
                panel.offsetHeight;
                panel.classList.add('open');
                // Scroll into view so user sees the content
                setTimeout(() => {
                    if (window.__lenisScrollTo) {
                        window.__lenisScrollTo(panel);
                    } else {
                        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }, 200);
            }
        });
    })();

    // ===== SHOPIFY-INSPIRED ENHANCEMENTS =====

    // --- 1. Lerp Mouse-Following Parallax on Witness Cards ---
    (function initWitnessCardParallax() {
        if (prefersReducedMotion) return;

        const cards = document.querySelectorAll('.witness-card');
        if (!cards.length) return;

        const MAX_TILT = 6;   // degrees
        const LERP_FACTOR = 0.08;

        cards.forEach(card => {
            let targetRotateX = 0;
            let targetRotateY = 0;
            let currentRotateX = 0;
            let currentRotateY = 0;
            let animating = false;

            function lerp(start, end, factor) {
                return start + (end - start) * factor;
            }

            function animate() {
                currentRotateX = lerp(currentRotateX, targetRotateX, LERP_FACTOR);
                currentRotateY = lerp(currentRotateY, targetRotateY, LERP_FACTOR);

                card.style.transform =
                    'perspective(800px) rotateX(' + currentRotateX.toFixed(2) + 'deg) rotateY(' + currentRotateY.toFixed(2) + 'deg) translateZ(4px)';

                // Keep animating until settled
                if (Math.abs(currentRotateX - targetRotateX) > 0.01 ||
                    Math.abs(currentRotateY - targetRotateY) > 0.01) {
                    requestAnimationFrame(animate);
                } else {
                    animating = false;
                }
            }

            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const relX = (e.clientX - rect.left) / rect.width;   // 0→1
                const relY = (e.clientY - rect.top) / rect.height;   // 0→1

                targetRotateX = (0.5 - relY) * MAX_TILT;  // Tilt up/down
                targetRotateY = (relX - 0.5) * MAX_TILT;  // Tilt left/right

                if (!animating) {
                    animating = true;
                    requestAnimationFrame(animate);
                }
            });

            card.addEventListener('mouseleave', () => {
                targetRotateX = 0;
                targetRotateY = 0;
                if (!animating) {
                    animating = true;
                    requestAnimationFrame(animate);
                }
            });
        });
    })();


