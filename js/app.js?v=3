    // --- Keyboard navigation ---
    let currentEraIndex = 0;
    const eraIds = ['era-prologue', 'era-the-word', 'era-the-struggle', 'era-the-solution', 'era-the-cage', 'era-the-crack', 'era-transition', 'era-the-signal'];

    document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
            e.preventDefault();
            currentEraIndex = Math.min(currentEraIndex + 1, eraIds.length - 1);
            const target = document.getElementById(eraIds[currentEraIndex]);
            if (window.__lenisScrollTo) {
                window.__lenisScrollTo(target);
            } else {
                target.scrollIntoView({ behavior: 'smooth' });
            }
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
            e.preventDefault();
            currentEraIndex = Math.max(currentEraIndex - 1, 0);
            const target = document.getElementById(eraIds[currentEraIndex]);
            if (window.__lenisScrollTo) {
                window.__lenisScrollTo(target);
            } else {
                target.scrollIntoView({ behavior: 'smooth' });
            }
        }
    });

    // Update currentEraIndex based on scroll
    eraIds.forEach((id, index) => {
        ScrollTrigger.create({
            trigger: '#' + id,
            start: 'top 50%',
            end: 'bottom 50%',
            onEnter: () => { currentEraIndex = index; },
            onEnterBack: () => { currentEraIndex = index; }
