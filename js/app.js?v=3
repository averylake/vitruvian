    // --- Prologue: skip animation if reloaded mid-page ---
    const prologue = document.getElementById('era-prologue');
    if (prologue && window.scrollY < 100) {
        const prologueLines = prologue.querySelectorAll('.text-line');
        prologueLines.forEach((line, i) => {
            setTimeout(() => {
