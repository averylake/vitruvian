    // --- Latin text tooltip (tap to translate) ---
    document.querySelectorAll('.latin-block').forEach(block => {
        block.addEventListener('click', () => {
            // Close other tooltips
            document.querySelectorAll('.latin-block.show-tooltip').forEach(b => {
                if (b !== block) b.classList.remove('show-tooltip');
            });
            block.classList.toggle('show-tooltip');
        });
    });

    // Close tooltips on outside click
    document.addEventListener('click', (e) => {
        if (!e.target.closest('.latin-block')) {
            document.querySelectorAll('.latin-block.show-tooltip').forEach(b => {
                b.classList.remove('show-tooltip');
            });
        }
    });

    // --- Era 4: Modulor Toggles ---
    const toggleProportions = document.getElementById('toggleProportions');
    const toggleCorbusier = document.getElementById('toggleCorbusier');
    const proportionsOverlay = document.querySelector('.modulor-proportions-overlay');
    const corbusierPanel = document.getElementById('corbusierPanel');

    if (toggleProportions && proportionsOverlay) {
