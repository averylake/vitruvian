/* ============================================================
   TRIPTYCH FLOW — Continuous animated version of the triptych
   Same three states (Body → Shift → Sphere) cycling in one canvas.
   Uses identical body slices, sphere radius, cube size, and colors
   as triptych.js for visual consistency.
   ============================================================ */
(function () {
    'use strict';
    if (typeof THREE === 'undefined') return;

    var canvas = document.getElementById('triptychFlowCanvas');
    if (!canvas) return;

    // ── CONFIG — Matches triptych.js exactly ────────────────────
    var CUBE_COUNT = 800;
    var CUBE_SIZE = 0.06;
    var SPHERE_RADIUS = 1.6;

    var COLOR_CONTAINER = new THREE.Color(0xddeeff);
    var COLOR_SIGNAL = new THREE.Color(0x00d4ff);

    // Phase timing (seconds per phase in a continuous loop)
    var BODY_HOLD = 1.5;
    var BODY_TO_SHIFT = 2.5;
    var SHIFT_HOLD = 2.5;
    var SHIFT_TO_SPHERE = 2.5;
    var SPHERE_HOLD = 3.0;
    var SPHERE_TO_BODY = 2.5;
    var TOTAL_CYCLE = BODY_HOLD + BODY_TO_SHIFT + SHIFT_HOLD + SHIFT_TO_SPHERE + SPHERE_HOLD + SPHERE_TO_BODY;

    // ── BODY SILHOUETTE — DUAL-POSE VITRUVIAN MAN ──────────────
    // Identical to triptych.js
    var bodySlices = [
        // ══════════════ SHARED — Head, Neck, Torso ══════════════
        { y: 2.4, xMin: -0.20, xMax: 0.20, z: 0.18 },
        { y: 2.2, xMin: -0.26, xMax: 0.26, z: 0.24 },
        { y: 2.0, xMin: -0.24, xMax: 0.24, z: 0.22 },
        { y: 1.8, xMin: -0.08, xMax: 0.08, z: 0.08 },
        { y: 1.55, xMin: -0.45, xMax: 0.45, z: 0.28 },
        { y: 1.45, xMin: -0.45, xMax: 0.45, z: 0.28 },
        { y: 1.2, xMin: -0.42, xMax: 0.42, z: 0.26 },
        { y: 0.9, xMin: -0.40, xMax: 0.40, z: 0.24 },
        { y: 0.6, xMin: -0.38, xMax: 0.38, z: 0.22 },
        { y: 0.3, xMin: -0.36, xMax: 0.36, z: 0.22 },
        { y: 0.0, xMin: -0.38, xMax: 0.38, z: 0.24 },
        { y: -0.3, xMin: -0.44, xMax: 0.44, z: 0.26 },
        { y: -0.6, xMin: -0.46, xMax: 0.46, z: 0.26 },
        // SQUARE MAN — Horizontal Arms
        { y: 1.55, xMin: -1.10, xMax: -0.45, z: 0.12 },
        { y: 1.45, xMin: -1.10, xMax: -0.45, z: 0.12 },
        { y: 1.55, xMin: -1.80, xMax: -1.10, z: 0.10 },
        { y: 1.45, xMin: -1.80, xMax: -1.10, z: 0.10 },
        { y: 1.55, xMin: -2.50, xMax: -1.80, z: 0.08 },
        { y: 1.45, xMin: -2.50, xMax: -1.80, z: 0.08 },
        { y: 1.55, xMin: -2.85, xMax: -2.50, z: 0.06 },
        { y: 1.45, xMin: -2.85, xMax: -2.50, z: 0.06 },
        { y: 1.55, xMin: 0.45, xMax: 1.10, z: 0.12 },
        { y: 1.45, xMin: 0.45, xMax: 1.10, z: 0.12 },
        { y: 1.55, xMin: 1.10, xMax: 1.80, z: 0.10 },
        { y: 1.45, xMin: 1.10, xMax: 1.80, z: 0.10 },
        { y: 1.55, xMin: 1.80, xMax: 2.50, z: 0.08 },
        { y: 1.45, xMin: 1.80, xMax: 2.50, z: 0.08 },
        { y: 1.55, xMin: 2.50, xMax: 2.85, z: 0.06 },
        { y: 1.45, xMin: 2.50, xMax: 2.85, z: 0.06 },
        // CIRCLE MAN — Raised Arms
        { y: 1.65, xMin: -0.90, xMax: -0.55, z: 0.08 },
        { y: 1.75, xMin: -1.15, xMax: -0.80, z: 0.08 },
        { y: 1.85, xMin: -1.40, xMax: -1.05, z: 0.07 },
        { y: 1.95, xMin: -1.65, xMax: -1.30, z: 0.07 },
        { y: 2.05, xMin: -1.88, xMax: -1.55, z: 0.06 },
        { y: 2.15, xMin: -2.10, xMax: -1.78, z: 0.06 },
        { y: 2.25, xMin: -2.35, xMax: -2.02, z: 0.05 },
        { y: 2.35, xMin: -2.55, xMax: -2.25, z: 0.05 },
        { y: 1.65, xMin: 0.55, xMax: 0.90, z: 0.08 },
        { y: 1.75, xMin: 0.80, xMax: 1.15, z: 0.08 },
        { y: 1.85, xMin: 1.05, xMax: 1.40, z: 0.07 },
        { y: 1.95, xMin: 1.30, xMax: 1.65, z: 0.07 },
        { y: 2.05, xMin: 1.55, xMax: 1.88, z: 0.06 },
        { y: 2.15, xMin: 1.78, xMax: 2.10, z: 0.06 },
        { y: 2.25, xMin: 2.02, xMax: 2.35, z: 0.05 },
        { y: 2.35, xMin: 2.25, xMax: 2.55, z: 0.05 },
        // SQUARE MAN — Together Legs
        { y: -0.9, xMin: -0.25, xMax: -0.05, z: 0.18 },
        { y: -0.9, xMin: 0.05, xMax: 0.25, z: 0.18 },
        { y: -1.3, xMin: -0.23, xMax: -0.05, z: 0.16 },
        { y: -1.3, xMin: 0.05, xMax: 0.23, z: 0.16 },
        { y: -1.7, xMin: -0.22, xMax: -0.05, z: 0.15 },
        { y: -1.7, xMin: 0.05, xMax: 0.22, z: 0.15 },
        { y: -2.1, xMin: -0.20, xMax: -0.04, z: 0.14 },
        { y: -2.1, xMin: 0.04, xMax: 0.20, z: 0.14 },
        { y: -2.5, xMin: -0.22, xMax: -0.03, z: 0.12 },
        { y: -2.5, xMin: 0.03, xMax: 0.22, z: 0.12 },
        { y: -2.9, xMin: -0.28, xMax: 0.00, z: 0.10 },
        { y: -2.9, xMin: 0.00, xMax: 0.28, z: 0.10 },
        { y: -3.1, xMin: -0.30, xMax: 0.02, z: 0.08 },
        { y: -3.1, xMin: -0.02, xMax: 0.30, z: 0.08 },
        // CIRCLE MAN — Spread Legs
        { y: -0.9, xMin: -0.55, xMax: -0.28, z: 0.18 },
        { y: -0.9, xMin: 0.28, xMax: 0.55, z: 0.18 },
        { y: -1.3, xMin: -0.72, xMax: -0.40, z: 0.16 },
        { y: -1.3, xMin: 0.40, xMax: 0.72, z: 0.16 },
        { y: -1.7, xMin: -0.88, xMax: -0.55, z: 0.15 },
        { y: -1.7, xMin: 0.55, xMax: 0.88, z: 0.15 },
        { y: -2.1, xMin: -1.02, xMax: -0.68, z: 0.14 },
        { y: -2.1, xMin: 0.68, xMax: 1.02, z: 0.14 },
        { y: -2.5, xMin: -1.15, xMax: -0.80, z: 0.12 },
        { y: -2.5, xMin: 0.80, xMax: 1.15, z: 0.12 },
        { y: -2.8, xMin: -1.22, xMax: -0.88, z: 0.10 },
        { y: -2.8, xMin: 0.88, xMax: 1.22, z: 0.10 }
    ];

    // Pre-compute slice volumes for weighted sampling
    var totalVol = 0, sliceVols = [];
    for (var s = 0; s < bodySlices.length; s++) {
        var vol = (bodySlices[s].xMax - bodySlices[s].xMin) * bodySlices[s].z * 0.3;
        sliceVols.push(vol);
        totalVol += vol;
    }

    // ── SAMPLERS (matching triptych.js) ─────────────────────────
    function sampleBody(count) {
        var positions = [];
        for (var i = 0; i < count; i++) {
            var pick = Math.random() * totalVol;
            var cum = 0, sl = bodySlices[0];
            for (var j = 0; j < sliceVols.length; j++) {
                cum += sliceVols[j];
                if (pick <= cum) { sl = bodySlices[j]; break; }
            }
            positions.push(
                sl.xMin + Math.random() * (sl.xMax - sl.xMin),
                sl.y + (Math.random() - 0.5) * 0.3,
                (Math.random() - 0.5) * sl.z * 2
            );
        }
        return positions;
    }

    function sampleShift(count) {
        var positions = [];
        var maxR = 5.5;
        for (var i = 0; i < count; i++) {
            var r = 2.5 + Math.random() * 3;
            var theta = Math.random() * Math.PI * 2;
            var phi = Math.acos(2 * Math.random() - 1);
            positions.push(
                r * Math.sin(phi) * Math.cos(theta),
                r * Math.sin(phi) * Math.sin(theta),
                r * Math.cos(phi)
            );
        }
        return positions;
    }

    function sampleSphere(count, radius) {
        var positions = [];
        for (var i = 0; i < count; i++) {
            var phi = Math.acos(1 - 2 * (i + 0.5) / count);
            var theta = Math.PI * (1 + Math.sqrt(5)) * i;
            positions.push(
                radius * Math.sin(phi) * Math.cos(theta),
                radius * Math.sin(phi) * Math.sin(theta),
                radius * Math.cos(phi)
            );
        }
        return positions;
    }

    // ── SETUP RENDERER ──────────────────────────────────────────
    var wrap = canvas.parentElement;
    var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    var scene = new THREE.Scene();
    var camera = new THREE.PerspectiveCamera(45, 2, 0.1, 100);
    camera.position.set(0, 0, 9);
    camera.lookAt(0, 0, 0);

    // Lighting (matching triptych.js)
    scene.add(new THREE.AmbientLight(0xffffff, 0.5));
    var light = new THREE.PointLight(0xffffff, 0.3);
    light.position.set(5, 5, 5);
    scene.add(light);

    // ── VITRUVIAN OVERLAY (circle + square) ──────────────────────
    // Matches the SVG overlay in the triptych HTML
    var circleGeo = new THREE.RingGeometry(2.95, 3.0, 64);
    var overlayMat = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.18, side: THREE.DoubleSide });
    var circleRing = new THREE.Mesh(circleGeo, overlayMat);
    circleRing.position.set(0, -0.15, -0.5);
    scene.add(circleRing);

    var squareShape = new THREE.Shape();
    squareShape.moveTo(-2.6, -2.9);
    squareShape.lineTo(2.6, -2.9);
    squareShape.lineTo(2.6, 2.6);
    squareShape.lineTo(-2.6, 2.6);
    squareShape.closePath();
    var squareHole = new THREE.Path();
    squareHole.moveTo(-2.55, -2.85);
    squareHole.lineTo(2.55, -2.85);
    squareHole.lineTo(2.55, 2.55);
    squareHole.lineTo(-2.55, 2.55);
    squareHole.closePath();
    squareShape.holes.push(squareHole);
    var squareGeo = new THREE.ShapeGeometry(squareShape);
    var squareMat = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.18, side: THREE.DoubleSide });
    var squareOutline = new THREE.Mesh(squareGeo, squareMat);
    squareOutline.position.set(0, -0.3, -0.5);
    scene.add(squareOutline);

    // ── GENERATE ALL THREE POSITION SETS ────────────────────────
    var bodyPositions = sampleBody(CUBE_COUNT);
    var shiftPositions = sampleShift(CUBE_COUNT);
    var spherePositions = sampleSphere(CUBE_COUNT, SPHERE_RADIUS);

    // Random per-cube data
    var rotations = [];
    var sizeScales = [];
    for (var i = 0; i < CUBE_COUNT; i++) {
        rotations.push(
            Math.random() * Math.PI * 2,
            Math.random() * Math.PI * 2,
            Math.random() * Math.PI * 2,
            0.4 + Math.random() * 1.2
        );
        sizeScales.push(0.6 + Math.random() * 0.8);
    }

    // ── INSTANCED MESH ──────────────────────────────────────────
    var geometry = new THREE.BoxGeometry(CUBE_SIZE, CUBE_SIZE, CUBE_SIZE);
    var material = new THREE.MeshPhongMaterial({
        color: 0xffffff,
        transparent: true,
        opacity: 0.85,
        shininess: 30
    });

    var mesh = new THREE.InstancedMesh(geometry, material, CUBE_COUNT);
    mesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);

    var instanceColors = new Float32Array(CUBE_COUNT * 3);
    mesh.instanceColor = new THREE.InstancedBufferAttribute(instanceColors, 3);
    mesh.instanceColor.setUsage(THREE.DynamicDrawUsage);

    scene.add(mesh);

    var dummy = new THREE.Object3D();

    // ── SMOOTHSTEP ──────────────────────────────────────────────
    function smoothstep(t) {
        t = Math.max(0, Math.min(1, t));
        return t * t * (3 - 2 * t);
    }

    // ── ANIMATION ───────────────────────────────────────────────
    var visible = false;
    var startTime = performance.now();
    var mixColor = new THREE.Color();

    // Camera Z for each phase (matching triptych.js per-panel values)
    var CAM_BODY = 9;
    var CAM_SHIFT = 8;
    var CAM_SPHERE = 5;

    function updateCubes(now) {
        var elapsed = (now - startTime) * 0.001;
        var cycleTime = elapsed % TOTAL_CYCLE;
        var time = elapsed;

        // Determine current phase and transition progress
        var fromPositions, toPositions;
        var fromColorMix, toColorMix;
        var fromCamZ, toCamZ;
        var t = 0;
        var overlayOpacity = 0;
        var rotationY = 0;
        var shiftFactor = 0; // 0 = body, 1 = shift/sphere (controls floating drift intensity)

        var t1 = BODY_HOLD;
        var t2 = t1 + BODY_TO_SHIFT;
        var t3 = t2 + SHIFT_HOLD;
        var t4 = t3 + SHIFT_TO_SPHERE;
        var t5 = t4 + SPHERE_HOLD;
        var t6 = t5 + SPHERE_TO_BODY;

        if (cycleTime < t1) {
            // Phase 1: Body hold
            fromPositions = bodyPositions;
            toPositions = bodyPositions;
            t = 0;
            fromColorMix = 0.27; toColorMix = 0.27;
            fromCamZ = CAM_BODY; toCamZ = CAM_BODY;
            overlayOpacity = 0.18;
            shiftFactor = 0;
        } else if (cycleTime < t2) {
            // Phase 2: Body → Shift (explosion)
            var p = (cycleTime - t1) / BODY_TO_SHIFT;
            t = smoothstep(p);
            fromPositions = bodyPositions;
            toPositions = shiftPositions;
            fromColorMix = 0.27; toColorMix = 0.07;
            fromCamZ = CAM_BODY; toCamZ = CAM_SHIFT;
            overlayOpacity = 0.18 * (1 - t);
            rotationY = time * 0.15 * t; // ramp rotation in smoothly
            shiftFactor = t;
        } else if (cycleTime < t3) {
            // Phase 3: Shift hold (floating)
            fromPositions = shiftPositions;
            toPositions = shiftPositions;
            t = 0;
            fromColorMix = 0.07; toColorMix = 0.07;
            fromCamZ = CAM_SHIFT; toCamZ = CAM_SHIFT;
            overlayOpacity = 0;
            rotationY = time * 0.15;
            shiftFactor = 1.0;
        } else if (cycleTime < t4) {
            // Phase 4: Shift → Sphere
            var p2 = (cycleTime - t3) / SHIFT_TO_SPHERE;
            t = smoothstep(p2);
            fromPositions = shiftPositions;
            toPositions = spherePositions;
            fromColorMix = 0.07; toColorMix = 1.0;
            fromCamZ = CAM_SHIFT; toCamZ = CAM_SPHERE;
            overlayOpacity = 0;
            rotationY = time * 0.15;
            shiftFactor = 1.0 - t * 0.5; // ease drift down as cubes converge
        } else if (cycleTime < t5) {
            // Phase 5: Sphere hold
            fromPositions = spherePositions;
            toPositions = spherePositions;
            t = 0;
            fromColorMix = 1.0; toColorMix = 1.0;
            fromCamZ = CAM_SPHERE; toCamZ = CAM_SPHERE;
            overlayOpacity = 0;
            rotationY = time * 0.15;
            shiftFactor = 0.5;
        } else {
            // Phase 6: Sphere → Body (loop back)
            var p3 = (cycleTime - t5) / SPHERE_TO_BODY;
            t = smoothstep(p3);
            fromPositions = spherePositions;
            toPositions = bodyPositions;
            fromColorMix = 1.0; toColorMix = 0.27;
            fromCamZ = CAM_SPHERE; toCamZ = CAM_BODY;
            overlayOpacity = 0.18 * t;
            rotationY = time * 0.15 * (1 - t);
            shiftFactor = 0.5 * (1 - t);
        }

        // Animate camera Z
        camera.position.z = fromCamZ + (toCamZ - fromCamZ) * t;

        // Animate overlay opacity
        circleRing.material.opacity = overlayOpacity;
        squareOutline.material.opacity = overlayOpacity;

        // Animate mesh rotation (shift and sphere rotate, body doesn't)
        mesh.rotation.y = rotationY;

        // Current color mix
        var currentMix = fromColorMix + (toColorMix - fromColorMix) * t;

        // Update each cube
        for (var i = 0; i < CUBE_COUNT; i++) {
            var fi = i * 3;
            var ri = i * 4;

            // Lerp position
            var px = fromPositions[fi] + (toPositions[fi] - fromPositions[fi]) * t;
            var py = fromPositions[fi + 1] + (toPositions[fi + 1] - fromPositions[fi + 1]) * t;
            var pz = fromPositions[fi + 2] + (toPositions[fi + 2] - fromPositions[fi + 2]) * t;

            // Subtle breathing/drift
            var r1 = rotations[ri];
            var r2 = rotations[ri + 1];
            var r3 = rotations[ri + 2];
            var spinSpeed = rotations[ri + 3];

            // Base breathing (always present)
            var breathAmp = 0.02 + shiftFactor * 0.03; // stronger when floating
            var breath = Math.sin(time * 1.5 + i * 0.01) * breathAmp;
            px += breath;
            py += breath * 0.5;

            // Per-cube organic floating drift (ramps in during Body→Shift)
            var drift = shiftFactor * 0.08;
            px += Math.sin(time * 0.7 + i * 1.37) * drift;
            py += Math.cos(time * 0.5 + i * 2.13) * drift;
            pz += Math.sin(time * 0.9 + i * 0.79) * drift * 0.5;

            dummy.position.set(px, py, pz);
            dummy.rotation.set(
                r1 + time * spinSpeed * 0.2,
                r2 + time * spinSpeed * 0.15,
                r3 + time * spinSpeed * 0.1
            );
            dummy.scale.setScalar(sizeScales[i]);
            dummy.updateMatrix();
            mesh.setMatrixAt(i, dummy.matrix);

            // Color
            mixColor.copy(COLOR_CONTAINER).lerp(COLOR_SIGNAL, currentMix);
            instanceColors[fi] = mixColor.r;
            instanceColors[fi + 1] = mixColor.g;
            instanceColors[fi + 2] = mixColor.b;
        }

        mesh.instanceMatrix.needsUpdate = true;
        mesh.instanceColor.needsUpdate = true;

        renderer.render(scene, camera);
    }

    function loop() {
        if (!visible) return;
        requestAnimationFrame(loop);
        updateCubes(performance.now());
    }

    // ── VISIBILITY ──────────────────────────────────────────────
    var container = document.getElementById('triptych-flow-section');
    if (container) {
        var observer = new IntersectionObserver(function (entries) {
            visible = entries[0].isIntersecting;
            if (visible) {
                startTime = performance.now();
                loop();
            }
        }, { threshold: 0.05 });
        observer.observe(container);
    }

    // ── RESIZE ──────────────────────────────────────────────────
    function resize() {
        var rect = wrap.getBoundingClientRect();
        var w = rect.width;
        var h = Math.min(rect.height, window.innerHeight * 0.9);
        if (w < 10 || h < 10) return;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
    }
    resize();
    window.addEventListener('resize', resize);

})();
