/* ============================================================
   TRIPTYCH — Three mini cube canvases side by side
   Da Vinci's model (white cubes) | The Shift (white→cyan) | Signal (cyan cubes)
   Uses InstancedMesh to match hero section's cubic geometry
   ============================================================ */

(function () {
    'use strict';

    if (typeof THREE === 'undefined') return;

    // ── SHARED CONFIG ──────────────────────────────────────
    var CUBE_COUNT = 800;
    var CUBE_SIZE = 0.06;
    var SPHERE_RADIUS = 1.6;

    // Brand colors
    var COLOR_CONTAINER = new THREE.Color(0xddeeff);  // white (container)
    var COLOR_SIGNAL = new THREE.Color(0x00d4ff);   // cyan (signal)

    // Body silhouette slices — DUAL-POSE VITRUVIAN MAN
    var bodySlices = [
